[Unit]
Description=AgroYachay 3 web (Next.js standalone)
After=network.target agroyachay-api.service

[Service]
User=andre
Group=andre
WorkingDirectory=/opt/apps/rust/agroyachay/web
Environment=NODE_ENV=production
Environment=PORT=3050
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
