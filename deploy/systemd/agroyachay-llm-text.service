[Unit]
Description=AgroYachay text model (llama.cpp llama-server, Qwen3-4B-Instruct-2507)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llama
Group=llama
WorkingDirectory=/var/lib/llama
ExecStart=/opt/llama.cpp/bin/llama-server \
    -m /var/lib/llama/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf \
    --alias qwen3-4b-instruct \
    --host 127.0.0.1 --port 8081 \
    -c 8192 --parallel 2 --jinja \
    --no-webui
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/llama/models
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
